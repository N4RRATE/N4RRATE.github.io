{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "博客：预览（包含草稿）",
      "type": "process",
      "command": "hugo",
      "args": [
        "server",
        "-D",
        "--bind",
        "127.0.0.1",
        "--disableFastRender",
        "--renderToMemory"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "博客：检查正式构建",
      "type": "process",
      "command": "hugo",
      "args": [
        "--gc",
        "--minify"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
